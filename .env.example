# Copy to .env.local and fill in. Never commit .env.local.

# Neon connection string (Neon console -> Connect). Use the pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random secret used to sign the admin session cookie (32+ characters).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Admin login. Generate the hash with: npm run hash-password -- "your password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# Public URL of the site, used for sitemap and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
